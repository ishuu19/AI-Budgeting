<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, and only the phone's built-in certificate authorities: a certificate someone
     installed on the phone cannot be used to read the app's traffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
