<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="capture_voice"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_voice_short"
        android:shortcutLongLabel="@string/shortcut_voice_long">
        <intent
            android:action="com.ledgerai.app.action.QUICK_CAPTURE"
            android:targetPackage="com.ledgerai.app"
            android:targetClass="com.ledgerai.app.service.QuickCaptureActivity">
            <extra android:name="capture_mode" android:value="voice" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="capture_photo"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_photo_short"
        android:shortcutLongLabel="@string/shortcut_photo_long">
        <intent
            android:action="com.ledgerai.app.action.QUICK_CAPTURE"
            android:targetPackage="com.ledgerai.app"
            android:targetClass="com.ledgerai.app.service.QuickCaptureActivity">
            <extra android:name="capture_mode" android:value="camera" />
        </intent>
    </shortcut>
</shortcuts>
