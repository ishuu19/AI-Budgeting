# LedgerAI – env reference (CI / Edge Functions / local)
# Android Gradle reads secrets.properties (see secrets.properties.example).

# --- Supabase ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
# SUPABASE_PUBLISHABLE_KEY=   # alias of anon
# SUPABASE_SECRET_KEY=        # server only — never in APK
# SUPABASE_JWKS_URL=

# --- App ---
APP_NAME=LedgerAI
DEFAULT_CURRENCY=USD
DEFAULT_CURRENCY_SYMBOL=$

# --- AI cascade: OpenRouter free → Gemini → DeepSeek → OpenRouter paid ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/
OPENROUTER_FREE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=

GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# POST {GEMINI_BASE_URL}/models/{AI_MODEL_GEMINI}:generateContent  (header X-goog-api-key)

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

AI_MODEL_OPENROUTER_FREE=deepseek/deepseek-chat-v3-0324:free
AI_MODEL_GEMINI=gemini-flash-latest
AI_MODEL_DEEPSEEK=deepseek-chat
AI_MODEL_OPENROUTER=deepseek/deepseek-chat
