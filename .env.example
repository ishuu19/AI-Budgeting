# LedgerAI – env reference (CI / Edge Functions / local tooling)
#
# Android Gradle does NOT read this file. For APK BuildConfig / local cascade keys,
# copy secrets.properties.example → secrets.properties (Gradle reads that file only).
# Keep this .env in sync for Edge Functions, scripts, and CI — not for Android builds.

# --- Supabase ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=   # alias of anon
# SUPABASE_SECRET_KEY=        # server only — never in APK
# SUPABASE_JWKS_URL=

# --- App ---
APP_NAME=LedgerAI
DEFAULT_CURRENCY=USD
DEFAULT_CURRENCY_SYMBOL=$

# --- AI cascade: OpenRouter free → Gemini → DeepSeek → OpenRouter paid ---
# These are NOT “never in the APK”:
#   - DEBUG Android: Gradle may inject the same keys into BuildConfig from
#     secrets.properties (not from this .env). Treat debug APKs as secret-bearing.
#   - RELEASE Android: AI BuildConfig fields must stay empty.
# Production target: Supabase Edge Function secrets; release app calls the
# Edge Function instead of embedding provider keys.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/
OPENROUTER_FREE_API_KEY=
OPENROUTER_API_KEY=

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Full path: {GEMINI_BASE_URL}/models/{AI_MODEL_GEMINI}:generateContent
# Header: X-goog-api-key: {GEMINI_API_KEY}

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# xAI / Grok (CLI / Edge Functions; not wired into Android cascade yet)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
AI_MODEL_XAI=grok-build-0.1
# Alt: grok-4.3

AI_MODEL_OPENROUTER_FREE=deepseek/deepseek-chat-v3-0324:free
AI_MODEL_GEMINI=gemini-flash-latest
AI_MODEL_DEEPSEEK=deepseek-chat
AI_MODEL_OPENROUTER=deepseek/deepseek-chat
