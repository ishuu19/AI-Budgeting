# =============================================================================
# LedgerAI – Build-time secrets (copy to secrets.properties and fill in values)
# Do NOT commit secrets.properties – it is in .gitignore
# =============================================================================

# --- OpenRouter (AI: transcription, parsing, chat) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/
AI_MODEL=anthropic/claude-3.7-sonnet

# --- App ---
APP_NAME=LedgerAI
APP_SITE_URL=https://ledgerai.app
DEFAULT_CURRENCY=USD
DEFAULT_CURRENCY_SYMBOL=$

# --- Google Sign-In (required for “Continue with Google” and calendar sync) ---
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Use “Web application” or “Android” client; for Android you need the WEB client ID
# (e.g. 123456789-xxxx.apps.googleusercontent.com) in SHA-1 signed requests.
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# --- Database (optional: MongoDB Atlas Device Sync) ---
# Leave empty to use local Realm only. If you enable Atlas sync, set your Realm App ID.
REALM_APP_ID=
