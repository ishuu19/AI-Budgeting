# =============================================================================
# LedgerAI – Build-time / local secrets
# Copy to secrets.properties and fill in values. Do NOT commit secrets.properties.
# =============================================================================

# --- Supabase (client) ---
# Prefer publishable/anon key in the app. NEVER put service_role / secret in BuildConfig.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
# Alias accepted by Gradle (same value as anon/publishable):
# SUPABASE_PUBLISHABLE_KEY=
# Server-only (Edge Functions / scripts — never ship in APK):
# SUPABASE_SECRET_KEY=
# SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# --- App ---
APP_NAME=LedgerAI
DEFAULT_CURRENCY=USD
DEFAULT_CURRENCY_SYMBOL=$

# =============================================================================
# AI provider cascade (Edge Function / backend secrets — not compiled into APK)
#
# Order on each request:
#   1) OpenRouter FREE models   → OPENROUTER_FREE_API_KEY (falls back to OPENROUTER_API_KEY)
#   2) Gemini                   → GEMINI_API_KEY then GEMINI_API_KEYS
#   3) DeepSeek                 → DEEPSEEK_API_KEY
#   4) OpenRouter paid / extra  → OPENROUTER_API_KEY then OPENROUTER_API_KEYS
# =============================================================================

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/
# Key used first, with free model ids (must support :free routes)
OPENROUTER_FREE_API_KEY=your_openrouter_key_for_free_models
# Primary OpenRouter key (also used if FREE key blank; then again at step 4)
OPENROUTER_API_KEY=your_openrouter_api_key
# Extra OpenRouter keys, comma-separated (rotated after primary is exhausted)
OPENROUTER_API_KEYS=

# Google AI Studio / Gemini API
GEMINI_API_KEY=your_gemini_api_key
# Extra Gemini keys, comma-separated
GEMINI_API_KEYS=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Call: POST {GEMINI_BASE_URL}/models/{AI_MODEL_GEMINI}:generateContent
# Header: X-goog-api-key: {GEMINI_API_KEY}

# DeepSeek (official API)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Default models per stage (override as needed)
AI_MODEL_OPENROUTER_FREE=deepseek/deepseek-chat-v3-0324:free
AI_MODEL_GEMINI=gemini-flash-latest
AI_MODEL_DEEPSEEK=deepseek-chat
AI_MODEL_OPENROUTER=deepseek/deepseek-chat


# Google Sign-In (Phase 2)
# GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
