# =============================================================================
# LedgerAI – Build-time / local secrets (Android Gradle)
# Copy to secrets.properties and fill in values. Do NOT commit secrets.properties.
#
# Gradle reads THIS file (not .env). See also .env.example for CI / Edge Functions.
# =============================================================================

# --- Supabase (client) ---
# Prefer publishable/anon key in the app. NEVER put service_role / secret in BuildConfig.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
# Alias accepted by Gradle (same value as anon/publishable):
# SUPABASE_PUBLISHABLE_KEY=
# Server-only (Edge Functions / scripts — never ship in APK):
# SUPABASE_SECRET_KEY=
# SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# --- App ---
APP_NAME=LedgerAI
DEFAULT_CURRENCY=USD
DEFAULT_CURRENCY_SYMBOL=$

# =============================================================================
# AI provider cascade
#
# Order on each request:
#   1) OpenRouter FREE models   → OPENROUTER_FREE_API_KEY (falls back to OPENROUTER_API_KEY)
#   2) Gemini                   → GEMINI_API_KEY then GEMINI_API_KEYS
#   3) DeepSeek                 → DEEPSEEK_API_KEY
#   4) OpenRouter paid / extra  → OPENROUTER_API_KEY then OPENROUTER_API_KEYS
#
# IMPORTANT — these are NOT “never in the APK”:
#   - DEBUG:   Gradle injects the values below into BuildConfig (see app/build.gradle.kts).
#              Debug APKs contain these secrets — do not distribute them.
#   - RELEASE: AI key/model BuildConfig fields MUST stay empty (gradle clears them).
#
# Production target: store provider keys as Supabase Edge Function secrets (or equivalent
# server env). The release app should call the Edge Function; keys must not ship in release APKs.
# =============================================================================

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/
# Key used first, with free model ids (must support :free routes)
OPENROUTER_FREE_API_KEY=your_openrouter_key_for_free_models
# Primary OpenRouter key (also used if FREE key blank; then again at step 4)
OPENROUTER_API_KEY=your_openrouter_api_key
# Extra OpenRouter keys, comma-separated (rotated after primary is exhausted)
OPENROUTER_API_KEYS=

# Google AI Studio / Gemini API
GEMINI_API_KEY=your_gemini_api_key
# Extra Gemini keys, comma-separated
GEMINI_API_KEYS=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Call: POST {GEMINI_BASE_URL}/models/{AI_MODEL_GEMINI}:generateContent
# Header: X-goog-api-key: {GEMINI_API_KEY}

# DeepSeek (official API)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# xAI / Grok (local tooling / future cascade; not in Android BuildConfig yet)
XAI_API_KEY=your_xai_api_key
XAI_BASE_URL=https://api.x.ai/v1
AI_MODEL_XAI=grok-build-0.1
# Alt: grok-4.3

# Default models per stage (override as needed)
AI_MODEL_OPENROUTER_FREE=deepseek/deepseek-chat-v3-0324:free
AI_MODEL_GEMINI=gemini-flash-latest
AI_MODEL_DEEPSEEK=deepseek-chat
AI_MODEL_OPENROUTER=deepseek/deepseek-chat


# Google Sign-In (Phase 2) — Web OAuth client ID (not Android client ID).
# Used by Credential Manager → Supabase signInWithIdToken. Placeholder only in this example.
SUPABASE_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
# Legacy alias accepted by Gradle if SUPABASE_GOOGLE_WEB_CLIENT_ID is blank:
# GOOGLE_WEB_CLIENT_ID=
